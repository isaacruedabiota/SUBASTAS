# ---------------------------------------------------------------------------
# Copia este fichero a .env y rellena los valores. .env NUNCA se commitea.
# El proyecto funciona sin ninguna clave: no hay servicios de pago.
# ---------------------------------------------------------------------------

# --- MCP (herramientas de desarrollo) --------------------------------------
# Context7: opcional. Sin key funciona con un límite de peticiones más bajo.
# https://context7.com -> Dashboard -> API Key
CONTEXT7_API_KEY=

# --- Base de datos -----------------------------------------------------------
# Ruta del fichero SQLite. Por defecto ./data/subastas.db
SUBASTAS_DB=

# --- Ingesta de datos --------------------------------------------------------
# User-Agent identificable para las peticiones a fuentes públicas.
INGEST_USER_AGENT="SubastasPersonal/0.1 (uso personal; contacto: isaacru04@gmail.com)"
# Milisegundos de espera entre peticiones a un mismo host.
INGEST_RATE_LIMIT_MS=3000
# Lectura de fichas del Portal, SIEMPRE bajo demanda y por identificador
# concreto (ver CLAUDE.md). Ponlo a false para bloquear cualquier acceso.
INGEST_PORTAL_ENABLED=true
# Directorio de caché en disco (por defecto data/cache/portal, vigencia 1 día).
INGEST_CACHE_DIR=

# --- Sesión en el Portal (para ver el importe de la puja en vivo) -------------
# OPCIONAL. A un visitante anónimo el Portal NO le da el importe de la puja
# mientras la subasta está en curso: donde iría la cifra pone "para ver su
# importe debe acceder como usuario registrado". No está oculto en el HTML, no
# se envía. Con sesión sí aparece.
#
# ⚠️ ESTAS DOS LÍNEAS NO BASTAN: el Portal usa doble factor. Después de la
# contraseña manda un código al correo Y al móvil. Hay que completarlo una vez,
# desde la web (pestaña "Cuenta") o desde la consola:
#
#     npm run entrar
#
# La sesión queda en la base de datos y sirve para todos los comandos y para la
# web hasta que caduque. Comprueba que sigue viva con:
#
#     npm run probar-sesion
#
# Sin sesión todo funciona igual, y la ficha dice la verdad: "hay pujas, importe
# reservado". Nunca se inventa un "sin pujas".
#
# Estas dos líneas son ya SOLO para importar la cuenta la primera vez: en cuanto
# hay una cuenta guardada, manda la base de datos y esto deja de mirarse. A
# partir de ahí las cuentas se gestionan en la web, y pueden ser varias.
#
# ⚠️ Esto es tu contraseña real del Portal en un fichero de texto. .env está
# fuera de git; ESTE fichero (.env.example) NO lo está, así que no pongas aquí
# las credenciales de verdad.
PORTAL_USUARIO=
PORTAL_CLAVE=
# Vigencia de la pestaña de pujas en la caché, en ms (por defecto 15 min). El
# resto de pestañas siguen valiendo un día: solo el importe se mueve.
PORTAL_VIGENCIA_PUJAS_MS=900000

# --- Vista de calle en la ficha ----------------------------------------------
# Ambas son opcionales: sin ninguna, la ficha muestra solo enlaces a Google
# Maps y a Street View, que no necesitan clave.
#
# Google Street View — se muestra EN VIVO y no se guarda ninguna imagen: sus
# términos no permiten almacenarlas ni cachearlas. La clave se queda en el
# servidor (la web hace de proxy en /api/streetview) y nunca sale en el HTML.
# https://console.cloud.google.com -> APIs -> "Street View Static API"
# Ojo: exige un proyecto de Google Cloud con facturación activada.
GOOGLE_MAPS_API_KEY=
#
# Street View NAVEGABLE empotrado (Maps Embed API). Es un <iframe>, así que la
# clave viaja al navegador por narices y no se puede proxear: usa una clave
# DISTINTA de la de arriba y restríngela por referente (localhost) en Google
# Cloud. Sin ella la ficha muestra la imagen estática, que sí pasa por el
# servidor. Ojo al prefijo NEXT_PUBLIC_: es lo que la expone al cliente.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
#
# Mapillary — fotos colaborativas CC-BY-SA 4.0. Estas SÍ se descargan y quedan
# en data/calle/ (npm run calles). Token gratuito y sin tarjeta.
# https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=
# Radio de búsqueda de la foto más cercana, en metros (por defecto 150).
MAPILLARY_RADIO_M=150
# Directorio donde se guardan (por defecto data/calle).
INGEST_DIR_CALLES=

# --- Avisos por correo (SMTP) ------------------------------------------------
# OPCIONAL. Sin esto, los avisos de las alertas se quedan en la web.
#
# Se usa SMTP y no una API de correo porque no hace falta ninguna cuenta nueva:
# vale el correo que ya usas. Con Gmail hay que crear una CONTRASEÑA DE
# APLICACIÓN (la contraseña normal no vale desde que hay verificación en dos
# pasos): Cuenta de Google -> Seguridad -> Contraseñas de aplicaciones.
#
# ⚠️ 465 es TLS desde el primer byte; 587 empieza en claro y sube con STARTTLS.
# Poner SMTP_SEGURO al revés del puerto da un timeout sin mensaje útil.
#
# Compruébalo sin enviar avisos con:  npm run notificar -- --probar
SMTP_HOST=
SMTP_PUERTO=465
SMTP_SEGURO=true
SMTP_USUARIO=
SMTP_CLAVE=
# Remitente. Por defecto "Subastas <SMTP_USUARIO>".
SMTP_DESDE=

# --- Avisos push al móvil ----------------------------------------------------
# NO hay nada que rellenar: las claves VAPID se generan solas la primera vez que
# se abre /ajustes y se guardan en la base de datos. No hace falta registrarse
# en ningún sitio ni pagar nada.
#
# ⚠️ Lo que SÍ hace falta es servir la web por HTTPS. El navegador solo permite
# notificaciones en contexto seguro: localhost vale, pero http://192.168.1.x no.
# La forma cómoda de conseguirlo sin abrir puertos es `tailscale serve`.
# En iPhone, además, hay que añadir la web a la pantalla de inicio.
#
# Contacto que se envía al servicio de push, por si hay que reclamar algo.
PUSH_CONTACTO=mailto:isaacru04@gmail.com
# Dirección por la que se llega a la web, para los enlaces de los avisos.
# También se puede cambiar desde /ajustes, que es lo normal.
WEB_URL=
